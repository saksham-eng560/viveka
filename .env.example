# Lighthouse configuration. Copy the relevant section into the matching .env file:
#   extension/.env, pulse-backend/.env (or repo-root .env), dashboard/.env

# ---------------------------------------------------------------------------
# Extension (build-time, extension/.env)
# ---------------------------------------------------------------------------
VITE_OLLAMA_URL=http://localhost:11434
VITE_AW_URL=http://localhost:5600
VITE_LLM_MODEL=qwen3.5:4b
VITE_NUDGE_THRESHOLD_SECONDS=60
# Sheru's brain (backend) and the dashboard, used by the popup and the tab reporter
VITE_BRAIN_URL=http://127.0.0.1:8000
VITE_DASHBOARD_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Backend (pulse-backend/.env)
# ---------------------------------------------------------------------------
AW_SERVER_URL=http://localhost:5600
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
# aw     = strict: ActivityWatch unreachable -> 503, other AW errors -> 502
# sample = always serve built-in demo data
# auto   = Sheru's local log if it has data for the day, else ActivityWatch, else sample data
# local  = only Sheru's local log
# Note: under Docker, aw-server must listen on an address reachable from the container
# (e.g. address = "0.0.0.0" in aw-server-rust config.toml); a 127.0.0.1-only bind or a
# 403 on the Host header triggers the sample fallback in auto mode.
DATA_SOURCE=auto
# template = Ollama down -> deterministic template standup; off = 503
STANDUP_FALLBACK=template
AW_BUCKET_PREFIX=aw-watcher-web-lighthouse
LLM_TIMEOUT_SECONDS=120
# Sheru (coach) settings
# where the profile (profile.json) and activity log (lighthouse.db) live; default <repo>/.data
# LIGHTHOUSE_DATA_DIR=
BUDDY_MODEL=sheru
# on = use the local model to judge ambiguous activity and to write Sheru's lines; off = rules + templates only
LLM_CLASSIFY=on
COACH_TICK_SECONDS=1

# ---------------------------------------------------------------------------
# Dashboard (dashboard/.env)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Setup notes
# ---------------------------------------------------------------------------
# Ollama must accept requests from the Chrome extension origin. Start it with:
#   OLLAMA_ORIGINS="chrome-extension://*" ollama serve
# aw-server-rust must allow the extension too. In its config.toml add:
#   cors_regex = "chrome-extension://.*"
