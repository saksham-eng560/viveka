# Pulse backend configuration (copy to .env). See ../.env.example for notes.
AW_SERVER_URL=http://localhost:5600
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
DATA_SOURCE=auto
STANDUP_FALLBACK=template
AW_BUCKET_PREFIX=aw-watcher-web-lighthouse
LLM_TIMEOUT_SECONDS=120
# Leo (coach) settings
# where the profile (profile.json) and activity log (viveka.db) live; default <repo>/.data
# VIVEKA_DATA_DIR=
# where the natural-voice model files live; default <repo>/.models
# VIVEKA_MODELS_DIR=
BUDDY_MODEL=viveka-leo
# on = use the local model to judge ambiguous activity and to write Leo's lines; off = rules + templates only
LLM_CLASSIFY=on
COACH_TICK_SECONDS=1
