{
  "manifest_version": 3,
  "name": "Sheru",
  "version": "3.0.0",
  "description": "Sheru, your private lion-cub focus buddy. Gentle, friendly reminders that bring you back to your goals. Everything stays on your device.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/assets/icon-16.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "offscreen",
    "scripting",
    "activeTab",
    "alarms",
    "tts",
    "tabGroups",
    "idle"
  ],
  "optional_permissions": [
    "management"
  ],
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:5600/*",
    "http://127.0.0.1:5600/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_title": "Sheru",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "48": "src/assets/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/index.tsx"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sheru.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
