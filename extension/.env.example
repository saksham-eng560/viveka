# Build-time defaults for the Viveka extension (copy to .env).
# Ollama must allow the extension origin:  OLLAMA_ORIGINS="chrome-extension://*" ollama serve
# aw-server-rust config.toml:              cors_regex = "chrome-extension://.*"
VITE_OLLAMA_URL=http://localhost:11434
VITE_AW_URL=http://localhost:5600
VITE_LLM_MODEL=qwen3.5:4b
VITE_NUDGE_THRESHOLD_SECONDS=60
